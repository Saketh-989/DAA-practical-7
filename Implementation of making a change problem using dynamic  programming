
def making_change(coins, amount):
    dp = [float('inf')] * (amount + 1)
    dp[0] = 0

    for i in range(1, amount + 1):
        for coin in coins:
            if coin <= i:
                dp[i] = min(dp[i], dp[i - coin] + 1)

    if dp[amount] == float('inf'):
        return -1

    return dp[amount]


coins = list(map(int, input("Enter coin denominations: ").split()))
amount = int(input("Enter the amount: "))

if amount < 0 or any(coin <= 0 for coin in coins):
    print("Enter a non-negative amount and positive coin denominations.")
else:
    result = making_change(coins, amount)

    if result == -1:
        print("Change cannot be made for this amount.")
    else:
        print("Minimum number of coins required:", result)

    print("Time Complexity: O(amount * number of coins)")
    print("Space Complexity: O(amount)")

